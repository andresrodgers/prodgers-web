# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:3001
NODE_ENV=development

# ──────────────────────────────────────────────
# PostgreSQL — usuario de aplicación (solo DML)
# En desarrollo apunta al contenedor en puerto 5434
# En producción apunta al contenedor interno prodgers_postgres:5432
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://prodgers_app:<password>@localhost:5434/prodgers_db

# ──────────────────────────────────────────────
# PostgreSQL — usuario migrador (DDL + DML)
# Solo para scripts de migración, nunca en runtime de la app
# ──────────────────────────────────────────────
DATABASE_MIGRATOR_URL=postgresql://prodgers_migrator:<password>@localhost:5434/prodgers_db

# ──────────────────────────────────────────────
# Auth
# Mínimo 64 caracteres aleatorios. Generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ──────────────────────────────────────────────
SESSION_SECRET=<minimo_64_caracteres_aleatorios>

# ──────────────────────────────────────────────
# Archivos / uploads
# En desarrollo: carpeta local. En producción: volumen Docker montado
# ──────────────────────────────────────────────
UPLOADS_PATH=./uploads

# ──────────────────────────────────────────────
# Correo transaccional (Resend)
# Requiere verificar el dominio remitente en el dashboard de Resend
# (registros SPF/DKIM/DMARC en Cloudflare). Si RESEND_API_KEY está
# vacío, los envíos se saltan sin romper nada — solo queda registrado
# el error en notificaciones.email_error.
# ──────────────────────────────────────────────
RESEND_API_KEY=<api_key_de_resend>
EMAIL_FROM=PRODGERS <notificaciones@prodgersenergy.com>

# ──────────────────────────────────────────────
# Contraseñas de PostgreSQL (usadas por docker-compose)
# ──────────────────────────────────────────────
POSTGRES_MIGRATOR_PASSWORD=<password_seguro>
POSTGRES_APP_PASSWORD=<password_seguro>

# ──────────────────────────────────────────────
# Seed admin — solo para el script de inicialización
# No se usa en runtime de la app
# ──────────────────────────────────────────────
ADMIN_NOMBRE=Admin Prodgers
ADMIN_DNI=<DNI_NIE_del_admin>
ADMIN_EMAIL=<email_del_admin>
ADMIN_PASSWORD=<password_temporal_debe_cambiarse>
